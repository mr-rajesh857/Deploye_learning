# Root Environment Template (.env.example)

# Database & Adminer
DB_ADMINER_URL=http://localhost:8080/?pgsql=postgres&username=postgres&db=Leave_management&ns=public
ADMINER_URL=http://localhost:8080/?pgsql=postgres&username=postgres&db=Leave_management&ns=public

DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5433
DB_NAME=Leave_management

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/Leave_management

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_ADMINER_URL=http://localhost:8080/?pgsql=postgres&username=postgres&db=Leave_management&ns=public
